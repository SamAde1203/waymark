{
  "name": "waymark",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "content:check": "pnpm --filter @waymark/content-schema check",
    "dev:site": "pnpm --filter @waymark/site dev",
    "build:site": "pnpm --filter @waymark/site build"
  }
}
