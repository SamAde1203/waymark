---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  lang?: string;
}
const { title, description, ogImage = "/og-default.jpg", lang = "en-GB" } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/favicon-180.png" />
    <meta name="theme-color" content="#0A192F" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Waymark" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/" aria-label="Waymark home">
          <img src="/favicon.svg" alt="" width="36" height="36" />
          <span>Waymark</span>
        </a>
        <nav class="nav" aria-label="Main">
          <a class="hide-sm" href="/how-it-works">How it works</a>
          <a class="hide-xs" href="/practice-test">Free practice test</a>
          <a class="hide-sm" href="/guides">Guides</a>
          <a class="hide-sm" href="/pricing">Pricing</a>
          <a class="hide-sm" href="/for-organisations">For organisations</a>
          <a class="btn small" href="/app">Start free</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="cols">
          <div>
            <img src="/favicon.svg" alt="" width="40" height="40" />
            <p>Every answer checked. Every step planned.</p>
            <p>Contact: <a href="mailto:hello@waymarkprep.co.uk">hello@waymarkprep.co.uk</a></p>
            <p><button type="button" class="btn secondary" data-share>Share Waymark</button></p>
          </div>
          <ul aria-label="Study">
            <li><a href="/app">Study app</a></li>
            <li><a href="/practice-test">Free practice test</a></li>
            <li><a href="/guides">Guides</a></li>
            <li><a href="/life-in-the-uk-test">About the test</a></li>
            <li><a href="/how-it-works">How it works</a></li>
            <li><a href="/pricing">Pricing</a></li>
          </ul>
          <ul aria-label="Waymark">
            <li><a href="/about">About Waymark</a></li>
            <li><a href="/for-organisations">For organisations</a></li>
            <li><a href="/help">Help and FAQ</a></li>
            <li><a href="/corrections">Corrections log</a></li>
            <li><a href="/pass-promise">Pass promise</a></li>
          </ul>
          <ul aria-label="Legal">
            <li><a href="/contact">Contact and business details</a></li>
            <li><a href="/terms">Terms of sale</a></li>
            <li><a href="/refunds">Cancellation and refunds</a></li>
            <li><a href="/privacy">Privacy</a></li>
            <li><a href="/cookies">Cookies</a></li>
            <li><a href="/accessibility">Accessibility</a></li>
            <li><a href="/independent">Independence and sources</a></li>
          </ul>
        </div>
        <p class="independence">
          Waymark is an independent study app. It is not affiliated with or endorsed by the UK Government, the Home
          Office, PSI or TSO. Questions are original practice items. For official information see
          <a href="https://www.gov.uk/life-in-the-uk-test" rel="noopener">gov.uk/life-in-the-uk-test</a>.
          <br />© {year} Waymark. <a href="/contact">Business details</a>.
        </p>
      </div>
    </footer>
    <script>
      // Share buttons: the phone's share sheet where there is one, otherwise copy the link.
      const SHARE_URL = "https://www.waymarkprep.co.uk";
      const SHARE_TEXT =
        "I'm preparing for the Life in the UK test with Waymark. Every practice question is checked against the official handbook, and explanations are available in Polish and Chinese. Try it free:";
      async function shareWaymark(btn: HTMLButtonElement, text = SHARE_TEXT) {
        const label = btn.textContent;
        try {
          if (navigator.share) {
            await navigator.share({ text, url: SHARE_URL });
            return;
          }
          await navigator.clipboard.writeText(`${text} ${SHARE_URL}`);
          btn.textContent = "Link copied";
        } catch (e) {
          if (e instanceof Error && e.name === "AbortError") return;
          btn.textContent = SHARE_URL;
        }
        setTimeout(() => (btn.textContent = label), 4000);
      }
      (window as unknown as { shareWaymark: typeof shareWaymark }).shareWaymark = shareWaymark;
      document.addEventListener("click", (ev) => {
        const btn = (ev.target as HTMLElement).closest<HTMLButtonElement>("[data-share]");
        if (btn) shareWaymark(btn, btn.dataset.shareText || SHARE_TEXT);
      });
    </script>
  </body>
</html>
