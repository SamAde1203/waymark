---
import Guide from "../../layouts/Guide.astro";

const dates: [string, string][] = [
  ["55 BC", "Julius Caesar's invasion fails"],
  ["AD 43", "Emperor Claudius leads a successful Roman invasion"],
  ["AD 410", "The Romans leave Britain"],
  ["AD 789", "The Vikings first raid Britain"],
  ["1066", "Battle of Hastings: William of Normandy defeats King Harold"],
  ["1215", "King John agrees to the Magna Carta"],
  ["1314", "Battle of Bannockburn: Robert the Bruce defeats the English"],
  ["1348", "The Black Death arrives"],
  ["1415", "Battle of Agincourt: Henry V defeats the French"],
  ["1455", "The Wars of the Roses begin"],
  ["1485", "Battle of Bosworth Field ends the Wars of the Roses; Henry VII becomes king"],
  ["1588", "The Spanish Armada is defeated"],
  ["1603", "James VI of Scotland becomes James I of England"],
  ["1642", "The English Civil War begins"],
  ["1649", "Charles I is executed"],
  ["1660", "The Restoration: Charles II returns"],
  ["1665", "Plague in London"],
  ["1666", "The Great Fire of London"],
  ["1679", "The Habeas Corpus Act"],
  ["1688", "The Glorious Revolution: William and Mary replace James II"],
  ["1689", "The Bill of Rights"],
  ["1707", "The Act of Union creates the Kingdom of Great Britain"],
  ["1746", "Battle of Culloden: Bonnie Prince Charlie is defeated"],
  ["1776", "13 American colonies declare independence"],
  ["1801", "The Act of Union joins Ireland"],
  ["1805", "Battle of Trafalgar: Admiral Nelson wins and is killed"],
  ["1807", "The slave trade is made illegal in British ships and ports"],
  ["1815", "Battle of Waterloo: Napoleon is defeated"],
  ["1832", "The Reform Act increases the number of voters"],
  ["1833", "Slavery is abolished throughout the British Empire"],
  ["1914–1918", "The First World War"],
  ["1918", "Women over 30 get the vote"],
  ["1928", "Women get the vote at the same age as men (21)"],
  ["1939–1945", "The Second World War"],
  ["1940", "The Battle of Britain; Dunkirk"],
  ["1944", "D-Day landings in Normandy (6 June)"],
  ["1947", "India and Pakistan become independent"],
  ["1948", "The NHS is founded"],
  ["1979", "Margaret Thatcher becomes the first woman Prime Minister"],
  ["1982", "The Falklands War"],
  ["1998", "The Good Friday (Belfast) Agreement"],
  ["1999", "The Scottish Parliament and Welsh Assembly are set up"],
];
---

<Guide slug="key-dates-to-learn" description="The key dates in British history for the Life in the UK test, in order on one page.">
  <p>
    Dates are where many people lose marks. Here are the ones that come up most in the history chapter, in order. You
    don't need to learn them all in one go: work through a century at a time, and test yourself.
  </p>

  <table>
    <thead><tr><th>Date</th><th>What happened</th></tr></thead>
    <tbody>
      {dates.map(([d, e]) => <tr><td><strong>{d}</strong></td><td>{e}</td></tr>)}
    </tbody>
  </table>

  <h2>Tips for remembering dates</h2>
  <ul>
    <li><strong>Pair them up.</strong> Plague 1665, fire 1666. Slave trade banned 1807, slavery abolished 1833.</li>
    <li><strong>Anchor on the big ones.</strong> 1066, 1215, 1588 and 1666 help you place the rest.</li>
    <li><strong>Little and often.</strong> Short daily reviews beat one long session.</li>
  </ul>
</Guide>
