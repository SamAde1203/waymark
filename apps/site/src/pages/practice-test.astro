---
import Base from "../layouts/Base.astro";
import { buildMock } from "@waymark/shared";
import Quiz from "../components/Quiz.astro";
import { loadItems } from "../lib/content";

// Public sample: a balanced 24 across the chapters. Uses approved items once there are
// enough of them; until then a preview sample of drafts, clearly labelled on the page.
const bank = loadItems();
const approved = bank.filter((i) => i.status === "live");
const usePreview = approved.length < 24;
const items = buildMock(bank, {
  seed: 20270101,
  statuses: usePreview ? ["live", "reviewed", "draft"] : ["live"],
});
const allLive = !usePreview;

---

<Base
  title="Free Life in the UK Practice Test with Answers and Explanations | Waymark"
  description="Try a free Life in the UK practice test. Instant marking, a plain-English explanation for every answer, and the handbook section each question comes from."
>
  <section class="section">
    <div class="wrap quiz">
      <h1>Free Life in the UK practice test</h1>
      <p>
        {items.length} original questions across all five handbook chapters. You get instant marking and a plain-English
        explanation after each answer. The real test has 24 questions in 45 minutes, and you need 18 correct (75%) to pass.
      </p>
      {
        !allLive && (
          <p class="banner" role="note">
            Preview: these questions are still going through our review against the handbook, so some section
            references may change.
          </p>
        )
      }

      <Quiz items={items} />
      <h2>Practise by chapter</h2>
      <ul>
        <li><a href="/practice/values-and-principles">Chapter 1: The values and principles of the UK</a></li>
        <li><a href="/practice/what-is-the-uk">Chapter 2: What is the UK?</a></li>
        <li><a href="/practice/history">Chapter 3: A long and illustrious history</a></li>
        <li><a href="/practice/modern-society">Chapter 4: A modern, thriving society</a></li>
        <li><a href="/practice/government-and-law">Chapter 5: The UK government, the law and your role</a></li>
      </ul>
    </div>
  </section>

</Base>
