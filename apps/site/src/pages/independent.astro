import Page from "../layouts/Page.astro";
import { INDEPENDENCE } from "../lib/site";
---

<Page
  title="Independence and sources | Waymark"
  description="Waymark is independent and not affiliated with the UK Government, the Home Office, PSI or TSO. How we source our questions."
  heading="Independence and sources"
>
  <p class="note">{INDEPENDENCE}</p>

  <h2>Official information</h2>
  <p>
    The Life in the UK test is run for the Home Office. For official information, including how to book, fees and ID
    rules, visit <a href="https://www.gov.uk/life-in-the-uk-test" rel="noopener">gov.uk/life-in-the-uk-test</a>. Waymark
    cannot book tests for you.
  </p>

  <h2>Our source</h2>
  <p>
    Our questions are based on the official handbook, <em>Life in the United Kingdom: A Guide for New Residents</em>
    (3rd edition), published by TSO on behalf of the Home Office. We write every question, explanation and summary in our
    own words. We do not reproduce the handbook, and we do not use real test questions, which are not published.
  </p>
  <p>
    We recommend getting your own copy of the handbook. Each Waymark question names the chapter and section it comes
    from, so you can check it.
  </p>

  <h2>Accuracy</h2>
  <p>
    "Correct" in Waymark means "matches the handbook", which is what the test is based on, even where the handbook is
    out of date. If you find an error, please <a href="mailto:support@waymarkprep.co.uk">report it</a>. Every fix is
    listed in our <a href="/corrections">corrections log</a>.
  </p>
</Page>
