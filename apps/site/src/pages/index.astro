---
import Base from "../layouts/Base.astro";
---

<Base
  title="Waymark: Life in the UK Test practice, every answer checked"
  description="Free Life in the UK practice test with explanations. Original questions with every answer traced to its section of the official handbook, a study plan built around your test date, and one price with no subscription."
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
      <h1>Pass the Life in the UK test, one marked step at a time.</h1>
      <p class="lead">
        Original practice questions with every answer traced to its handbook section, a study plan built around your
        test date, and one price with no subscription.
      </p>
      <div class="actions">
        <a class="btn" href="/app">Start studying free</a>
        <a class="btn secondary" href="/practice-test">Take a free practice test</a>
      </div>
      <p class="independent-note">
        Waymark is an independent study app. It is not affiliated with or endorsed by the UK Government, the Home Office,
        PSI or TSO.
      </p>
      </div>
      <figure class="hero-art">
        <img
          src="/hero-phones-800.webp"
          srcset="/hero-phones-800.webp 800w, /hero-phones.webp 1600w"
          sizes="(min-width: 900px) 480px, 92vw"
          width="800"
          height="760"
          alt="Two phones showing the same Waymark practice question with its explanation in English, and underneath in Polish on one phone and in Chinese on the other."
          fetchpriority="high"
        />
        <figcaption>Explanations in English, <a href="/pl" lang="pl">Polski</a>, <a href="/zh" lang="zh-Hans">中文</a>, <a href="/ur" lang="ur" dir="rtl">اردو</a>, <a href="/ar" lang="ar" dir="rtl">العربية</a> and <a href="/ro" lang="ro">Română</a></figcaption>
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Why Waymark</h2>
      <div class="cards">
        <div class="card">
          <h3>Every answer checked</h3>
          <p>
            Each question names the handbook chapter and section it comes from, so you can check it in your own copy.
            Every correction we make is listed publicly.
          </p>
        </div>
        <div class="card">
          <h3>Every step planned</h3>
          <p>
            Tell us your test date. Waymark builds a daily plan and brings back the facts you are about to forget,
            right up to test day.
          </p>
        </div>
        <div class="card">
          <h3>One price, no subscription</h3>
          <p>Pay once for full access. No weekly charges, no auto-renewal, no adverts.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <h2>How it works</h2>
      <ol class="steps">
        <li><strong>Take a free diagnostic.</strong> 24 questions show where you stand across all five chapters.</li>
        <li><strong>Follow your daily plan.</strong> Short sessions, sized to the time you have before your test.</li>
        <li><strong>Practise under test conditions.</strong> Timed 24-question mocks, 45 minutes, pass mark 18.</li>
        <li><strong>Check your readiness.</strong> An honest estimate based on your practice, not a promise.</li>
      </ol>
      <p><a class="btn" href="/practice-test">Start with the free practice test</a></p>
    </div>
  </section>
</Base>
