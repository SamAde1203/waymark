{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd ../.. && pnpm build:web",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/guides",
      "destination": "/guides.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/app"
    }
  ]
}
